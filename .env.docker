# ============================================
# Docker Compose 專用環境變數
# ============================================
# 此檔案專門給 docker-compose up 使用
# 使用方式：cp .env.docker .env
#
# ⚠️ 生產環境部署前請修改所有密碼！
# ============================================

# ============================================
# 資料庫設定
# ============================================
# 🔧 容器內使用服務名稱 'postgres' 作為主機名
DATABASE_URL="postgresql://fhn_user:fhn_password@postgres:5432/fhn_db"

# ⚠️ 生產環境請改密碼：
# DATABASE_URL="postgresql://fhn_user:YOUR_SECURE_PASSWORD@postgres:5432/fhn_db"

# ============================================
# 儲存設定
# ============================================
# Docker 環境使用內建的 MinIO
STORAGE_MODE=minio

# MinIO 設定（容器內使用服務名稱 'minio'）
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=images
MINIO_USE_SSL=false

# ⚠️ 生產環境請改密碼（需同步修改 docker-compose.yml）：
# MINIO_ACCESS_KEY=your_access_key
# MINIO_SECRET_KEY=your_secure_secret_key

# ============================================
# 選項：改用 Supabase Storage（雲端）
# ============================================
# 如果想在 Docker 環境用 Supabase 而非 MinIO：
#
# STORAGE_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key

# ============================================
# Next.js 設定
# ============================================
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:3000

# 🌐 如果部署到伺服器，改成你的網域：
# NEXT_PUBLIC_API_URL=https://yourdomain.com
