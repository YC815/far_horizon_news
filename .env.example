# ============================================
# 環境變數範本
# ============================================
# 這是主要的環境變數範本，根據使用場景複製到 .env
#
# 使用方式：
#   開發環境： cp .env.example .env（然後選擇下方場景之一）
#   Docker：   使用 .env.docker（已預配置）
#
# ⚠️ 注意：.env 檔案包含敏感資訊，永遠不要提交到 Git！
# ============================================

# ============================================
# 場景 1：本地開發 + Supabase（推薦給初學者）
# ============================================
# 優點：無需安裝資料庫，使用雲端服務
# 前往 https://supabase.com 建立免費專案

# 資料庫（使用 Supabase PostgreSQL）
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 儲存模式
STORAGE_MODE=supabase

# Supabase 設定
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Next.js
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# 場景 2：本地開發 + SQLite（最簡單）
# ============================================
# 優點：零依賴，但檔案儲存仍需 Supabase
#
# DATABASE_URL="file:./dev.db"
# STORAGE_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
# NODE_ENV=development
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# 場景 3：本地開發 + Docker 服務（進階）
# ============================================
# 優點：模擬生產環境，應用程式本地跑（熱重載）
# 先執行：docker-compose up postgres minio minio_init
#
# DATABASE_URL="postgresql://fhn_user:fhn_password@localhost:5432/fhn_db"
# STORAGE_MODE=minio
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minio_admin
# MINIO_SECRET_KEY=minio_password
# MINIO_BUCKET=images
# MINIO_USE_SSL=false
# NODE_ENV=development
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# 場景 4：完整 Docker Compose（生產模擬）
# ============================================
# 請使用 .env.docker 而非此檔案
# 執行：cp .env.docker .env && docker-compose up
